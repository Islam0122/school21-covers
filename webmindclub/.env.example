# Copy to .env and adjust. Never commit the real .env.

# --- Django ---
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins the SPA is served from (Vite dev server and/or docker nginx)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Secure (HTTPS-only) cookies. Keep true in production behind HTTPS; false for plain-http local use.
DJANGO_SECURE_COOKIES=false
# Used to build password-reset and invitation links
FRONTEND_URL=http://localhost:8080

# --- Email ---
# Console backend prints emails (reset links, invitations) to the backend log.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=WebMindClub <no-reply@example.com>
# For SMTP use django.core.mail.backends.smtp.EmailBackend and set EMAIL_HOST etc.

# --- PostgreSQL ---
POSTGRES_DB=webmindclub
POSTGRES_USER=webmind
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Optional demo seed (docker entrypoint) ---
# Set to the email of an EXISTING user to create the WebMindClub demo workspace on startup.
DEMO_OWNER_EMAIL=
